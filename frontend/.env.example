# Base URL of the Laravel API (no trailing slash).
VITE_API_BASE_URL=http://localhost:8000

# Google Drive API key used to read PUBLIC Drive folders directly from the
# browser (no backend needed). The key must have the "Google Drive API"
# enabled, and — if it has an HTTP-referrer restriction — your site's domain
# must be in the allowed list. Only public ("Anyone with the link") folders
# are readable with an API key.
VITE_GOOGLE_API_KEY=
