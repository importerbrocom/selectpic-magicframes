# =============================================================================
# Production environment template for selectpic.magicframes.nokkoo.in (cPanel)
# -----------------------------------------------------------------------------
# Copy this to `.env` on the server and fill in the real secrets. NEVER commit
# the real .env. Generate APP_KEY on the server with:  php artisan key:generate
# =============================================================================

APP_NAME="SelectPic MagicFrames"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://selectpic.magicframes.nokkoo.in

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# -----------------------------------------------------------------------------
# Database (cPanel MySQL)
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=uddjzwrz_selectpic
# Your cPanel MySQL user (created and granted to the database above):
DB_USERNAME=uddjzwrz_selectpic
# Set the rotated DB password here (do not commit it):
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Sessions / cache / queue — safe defaults for shared hosting
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# -----------------------------------------------------------------------------
# CORS — not needed for the single-domain setup (frontend served from Laravel),
# but kept here for reference if you ever split the frontend onto another host.
# -----------------------------------------------------------------------------
FRONTEND_URL=https://selectpic.magicframes.nokkoo.in

# -----------------------------------------------------------------------------
# Google Drive integration — set ONE of the following.
# -----------------------------------------------------------------------------
# Absolute path on the server to a service account JSON key (private folders):
GOOGLE_SERVICE_ACCOUNT_JSON=
# Or an API key (publicly shared folders only):
GOOGLE_DRIVE_API_KEY=
